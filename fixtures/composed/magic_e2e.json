      "labels": [
        "Analytical_Pattern"
      ],
      "properties": {
        "name": "Magic E2E Test Pattern",
        "description": "Two parallel magic_operator producers (one sync_http, one async_http) feeding a third magic_operator consumer -- used by the CI e2e test suite.",
        "process": "e2e-test",
        "publishedDate": "2026-07-27"
      }
    },
    {
      "id": "d0000000-0000-0000-0000-000000000002",
      "labels": [
        "Magic_Echo_A_Operator",
        "Operator"
      ],
      "properties": {
        "name": "Magic Echo A",
        "description": "Renders a summary prompt for a topic and returns the (mocked) LLM response. Runs in sync_http mode.",
        "version": "1.0.0",
        "inputs": [
          {
            "name": "topic",
            "type": "string",
            "required": true,
            "default": ""
          }
        ],
        "outputs": [
          {
            "name": "summary",
            "type": "string",
            "required": true,
            "default": ""
          }
        ]
      }
    },
    {
      "id": "d0000000-0000-0000-0000-000000000003",
      "labels": [
        "Magic_Echo_B_Operator",
        "Operator"
      ],
      "properties": {
        "name": "Magic Echo B",
        "description": "Renders a tone-of-voice prompt for an audience and returns the (mocked) LLM response. Runs in async_http mode.",
        "version": "1.0.0",
        "inputs": [
          {
            "name": "audience",
            "type": "string",
            "required": true,
            "default": ""
          }
        ],
        "outputs": [
          {
            "name": "tone",
            "type": "string",
            "required": true,
            "default": ""
          }
        ]
      }
    },
    {
      "id": "d0000000-0000-0000-0000-000000000004",
