      }
    },
    {
      "id": "d0000000-0000-0000-0000-000000000005",
      "labels": [
        "ResultType",
        "string"
      ],
      "properties": {
        "name": "tone"
      }
    },
    {
      "id": "d0000000-0000-0000-0000-000000000006",
      "labels": [
        "Magic_Combine_Operator",
        "Operator"
      ],
      "properties": {
        "name": "Magic Combine",
        "description": "Combines the summary and tone produced upstream into one final message. Runs in sync_http mode.",
        "version": "1.0.0",
        "inputs": [
          {
            "name": "summary",
            "type": "string",
            "required": true,
            "default": ""
          },
          {
            "name": "tone",
            "type": "string",
            "required": true,
            "default": ""
          }
        ],
        "outputs": [
          {
            "name": "message",
            "type": "string",
            "required": true,
            "default": ""
          }
        ]
      }
    }
