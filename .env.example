# Consul (operator service registry)
CONSUL_HTTP_ADDR=http://localhost:8500

# Dapr sidecar (workflow orchestration) - defaults match the SDK's own defaults
DAPR_RUNTIME_HOST=localhost
DAPR_GRPC_PORT=50001
DAPR_HTTP_PORT=3500

# How long POST /execute blocks waiting for a workflow to complete before
# returning a 504 pointing the caller at the async poll endpoint instead.
SYNC_EXECUTION_TIMEOUT_SECONDS=60

# API Configuration
# ROOT_PATH is used when the API is behind a reverse proxy
# ROOT_PATH=

# --- magic_operator (magic_operator/main.py) -- reference/test operator, only needed when running it ---
# It's fully self-sufficient (serves its own manifest + health + execute
# endpoints, no sidecar). Registration with Consul is handled externally --
# a Consul client agent alongside it locally (see e2e/consul-services/*.hcl
# and e2e/docker-compose.yml), or Kubernetes Service Sync in production (see
# docs/docs/operators.md). Its own declaration (name/version/execution_mode/
# output_name/prompt_template/inputs) lives in a mounted YAML file -- see
# e2e/manifests/magic-echo-a.yaml for an example.
MAGIC_OPERATOR_CONFIG_PATH=e2e/manifests/magic-echo-a.yaml
MAGIC_OPERATOR_LLM_PROVIDER=mock
