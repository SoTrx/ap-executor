# Consul (operator service registry)
CONSUL_HTTP_ADDR=http://localhost:8500

# Dapr sidecar (workflow orchestration) - defaults match the SDK's own defaults
DAPR_RUNTIME_HOST=localhost
DAPR_GRPC_PORT=50001
DAPR_HTTP_PORT=3500

# How long POST /execute blocks waiting for a workflow to complete before
# returning a 504 pointing the caller at the async poll endpoint instead.
SYNC_EXECUTION_TIMEOUT_SECONDS=60

# API Configuration
# ROOT_PATH is used when the API is behind a reverse proxy
# ROOT_PATH=

# --- Operator sidecar (sidecar/main.py) -- only needed when running the sidecar ---
# The operator's manifest (name/version/execution/inputs/outputs) lives in a
# mounted YAML file, not env vars -- see manifests/magic-echo-a/manifest.yaml
# for an example, and docs/docs/configuration.md for the full reference.
SIDECAR_SERVICE_NAME=Text to SQL
SIDECAR_ADVERTISE_ADDRESS=localhost
UPSTREAM_HOST=localhost
UPSTREAM_PORT=9000
OPERATOR_MANIFEST_PATH=manifests/dummy-operator/manifest.yaml

# --- magic_operator (magic_operator/main.py) -- reference/test operator, only needed when running it ---
# The operator's own declaration (name/execution_mode/output_name/
# prompt_template/inputs) also lives in a mounted YAML file -- see
# manifests/magic-echo-a/magic-operator.yaml for an example.
MAGIC_OPERATOR_CONFIG_PATH=manifests/magic-echo-a/magic-operator.yaml
MAGIC_OPERATOR_LLM_PROVIDER=mock
